STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
# Production only (the droplet gets these from GitHub secrets; docs/hosting.md): verified TLS to
# Supabase with the Supabase CA file. Leave unset for a local database.
# DB_SSL=true
# DB_CA_PATH=/run/secrets/supabase-ca.crt
DB_NAME=jewellery
STORE_NAME=Azira
# Seller's ABN, printed on the order confirmation (tax invoice) email. Leave empty to omit the ABN line.
# Required for a valid Australian tax invoice once the store is GST-registered.
STORE_ABN=
# Preview mode ("payments paused"): true lets production start without Stripe keys and with
# EMAIL_TRANSPORT=console, and makes the backend refuse POST /store/carts/:id/complete and
# payment-session creation (403). Only the exact text "true" pauses. Leave empty or false for a
# normal shop (src/lib/checkout-paused.ts, src/lib/production-env.ts). The storefront has its
# own NEXT_PUBLIC_CHECKOUT_PAUSED.
CHECKOUT_PAUSED=
# Stripe. Production refuses to start with an empty or placeholder key unless CHECKOUT_PAUSED=true
# (src/lib/production-env.ts). The Stripe provider is registered only when STRIPE_API_KEY is set.
# Webhook endpoint: https://api.azira.com.au/hooks/payment/stripe_stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Files (src/lib/file-storage.ts) ---
# Unset: the local file provider (uploads go to apps/backend/static). Production: Cloudflare R2.
# FILE_PROVIDER=s3
# FILE_URL=https://img.azira.com.au
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://7b7865326875e0dea1285c31309d77a4.r2.cloudflarestorage.com
# R2_BUCKET=azira-images

# --- Email (src/modules/email, src/lib/email-config.ts) ---
# "console" logs every email instead of sending it (local default). "resend" sends
# through Resend. Leave empty: resend when RESEND_API_KEY is set, console otherwise.
EMAIL_TRANSPORT=
# Resend API key. Required when the transport is resend.
RESEND_API_KEY=
# Sender, "orders@azira.com.au" or "Azira <orders@azira.com.au>". Required for resend.
# The domain must be verified in Resend (SPF/DKIM).
EMAIL_FROM=
# Optional. Where customer replies go (a monitored inbox).
EMAIL_REPLY_TO=
# Optional, console transport only and never in production: folder that gets an HTML copy of every email.
EMAIL_OUTBOX_DIR=
# The store owner. Gets a "new order" email for every order placed.
STORE_NOTIFY_EMAIL=
# Where custom order enquiries (the storefront form) are emailed. Placeholder until the client gives the real address.
CUSTOM_ORDER_EMAIL=orders@example.com
# Base URL of the storefront including the country code, no trailing slash. Used for links in emails.
STOREFRONT_URL=http://localhost:8000/au
# Public URL of this backend. Used for admin links in emails (the admin app is at <url>/app).
MEDUSA_BACKEND_URL=http://localhost:9000
