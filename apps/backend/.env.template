STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=jewellery
STORE_NAME=Jewellery Store
# Seller's ABN, printed on the order confirmation (tax invoice) email. Leave empty to omit the ABN line.
# Required for a valid Australian tax invoice once the store is GST-registered.
STORE_ABN=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (src/modules/email, src/lib/email-config.ts) ---
# "console" logs every email instead of sending it (local default). "resend" sends
# through Resend. Leave empty: resend when RESEND_API_KEY is set, console otherwise.
EMAIL_TRANSPORT=
# Resend API key. Required when the transport is resend.
RESEND_API_KEY=
# Sender, "orders@example.com.au" or "Store Name <orders@example.com.au>". Required for resend.
# The domain must be verified in Resend (SPF/DKIM).
EMAIL_FROM=
# Optional. Where customer replies go (a monitored inbox).
EMAIL_REPLY_TO=
# Optional, console transport only and never in production: folder that gets an HTML copy of every email.
EMAIL_OUTBOX_DIR=
# The store owner. Gets a "new order" email for every order placed.
STORE_NOTIFY_EMAIL=
# Where custom order enquiries (the storefront form) are emailed. Placeholder until the client gives the real address.
CUSTOM_ORDER_EMAIL=orders@example.com
# Base URL of the storefront including the country code, no trailing slash. Used for links in emails.
STOREFRONT_URL=http://localhost:8000/au
# Public URL of this backend. Used for admin links in emails (the admin app is at <url>/app).
MEDUSA_BACKEND_URL=http://localhost:9000
