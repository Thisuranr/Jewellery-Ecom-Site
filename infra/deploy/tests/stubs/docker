#!/usr/bin/env bash
# Test stub for `docker` (infra/deploy/tests/run.sh). Logs every call, with
# IMAGE_TAG, to $STUB_LOG and fakes just enough of docker compose and docker
# inspect for deploy.sh. State lives in $STUB_STATE.
#
# Knobs (environment):
#   STUB_FAIL_PULL=1 / STUB_FAIL_MIGRATE=1 / STUB_FAIL_UP=1   that step fails
#   STUB_FAIL_SERVICES=1   `up ... redis cloudflared` fails
#   STUB_UNHEALTHY="<tag> ..."   containers on these tags report unhealthy
#   STUB_STARTING="<tag> ..."    containers on these tags never leave starting
#   STUB_BAD_LABEL=1      the image's revision label is wrong
#   STUB_IMAGES="<tag> ..."      sha tags `docker image ls` reports
#   STUB_FAIL_LOGIN=1     `docker login` fails
set -euo pipefail

repo=ghcr.io/test/azira-backend
printf 'IMAGE_TAG=%s docker %s\n' "${IMAGE_TAG:-}" "$*" >>"$STUB_LOG"

has() { # has <word> <list>
  local w
  for w in $2; do [[ $w == "$1" ]] && return 0; done
  return 1
}

if [[ ${1-} == compose ]]; then
  shift
  args=" $* "
  case $args in
    *" pull medusa "*)
      [[ ${STUB_FAIL_PULL:-0} == 1 ]] && { echo "pull: denied" >&2; exit 1; }
      exit 0 ;;
    *" config --images "*)
      printf '%s\n' "$repo:${IMAGE_TAG:?}" "redis:7.4.11-bookworm@sha256:0" "cloudflare/cloudflared:2026.10.0@sha256:0"
      exit 0 ;;
    *" up "*" redis cloudflared "*)
      [[ ${STUB_FAIL_SERVICES:-0} == 1 ]] && exit 1
      exit 0 ;;
    *" run --rm -T migrate "*)
      # STUB_PROBE_STDIN=1: note whether the migrate container could read the
      # caller's stdin (db:migrate's link-sync prompt would read it).
      if [[ ${STUB_PROBE_STDIN:-0} == 1 ]] && IFS= read -r -t 2 _line; then
        echo "migrate read stdin" >>"$STUB_LOG"
      fi
      [[ ${STUB_FAIL_MIGRATE:-0} == 1 ]] && { echo "migration error" >&2; exit 1; }
      exit 0 ;;
    *" up -d --no-deps medusa "*)
      [[ ${STUB_FAIL_UP:-0} == 1 ]] && exit 1
      printf '%s\n' "${IMAGE_TAG:?}" >"$STUB_STATE/running"
      exit 0 ;;
    *" stop medusa "*)
      rm -f "$STUB_STATE/running"
      exit 0 ;;
    *" ps -q medusa "*)
      [[ -f $STUB_STATE/running ]] && echo "cid-$(cat "$STUB_STATE/running")"
      exit 0 ;;
  esac
  echo "docker stub: unexpected compose call: $*" >&2
  exit 99
fi

case "$*" in
  "login ghcr.io -u "*" --password-stdin")
    # The token arrives on stdin; log only its length, never the value.
    tok=$(cat)
    printf 'login-token-length=%s\n' "${#tok}" >>"$STUB_LOG"
    [[ ${STUB_FAIL_LOGIN:-0} == 1 ]] && exit 1
    exit 0 ;;
  "image inspect --format "*)
    ref=${*: -1}
    if [[ ${STUB_BAD_LABEL:-0} == 1 ]]; then echo unknown; else echo "${ref##*:}"; fi
    exit 0 ;;
  "inspect --format {{.Config.Image}} cid-"*)
    cid=${*: -1}
    echo "$repo:${cid#cid-}"
    exit 0 ;;
  "inspect --format {{if .State.Health}}"*" cid-"*)
    cid=${*: -1}
    tag=${cid#cid-}
    if has "$tag" "${STUB_UNHEALTHY:-}"; then echo unhealthy
    elif has "$tag" "${STUB_STARTING:-}"; then echo starting
    else echo healthy; fi
    exit 0 ;;
  "image ls --format "*)
    for t in ${STUB_IMAGES:-}; do echo "$repo:$t"; done
    echo "$repo:<none>"
    exit 0 ;;
  "image rm "*)
    exit 0 ;;
esac
echo "docker stub: unexpected call: $*" >&2
exit 99
