# Production settings for the Medusa backend (Azira).
#
# You never copy this file to the server. The GitHub workflow "Backend deploy"
# builds these lines from GitHub repository secrets and variables and sends them
# to the droplet, where infra/deploy/apply-env.sh checks every key against an
# allow-list and writes /opt/azira/.env (root, 0600). This file only documents
# the keys and their formats; docs/hosting.md says where each value comes from.
#
# Rules for values (apply-env.sh refuses anything else):
# - One line, KEY=value, no quotes, no spaces around "=".
# - No $ " ' \ or backtick anywhere, no space at the start or end, no " #".
#   (Docker Compose would expand or unquote them.) Make secrets with
#   `openssl rand -hex 32`, or in PowerShell: -join ((1..32 | % { '{0:x2}' -f (Get-Random -Max 256) }))
#   (hex has none of these). The database password goes into DATABASE_URL: use
#   letters and digits, or percent-encode the rest (@ is %40).
# - The keys below marked "special" are consumed by apply-env.sh and never end
#   up in /opt/azira/.env.
#
# The app itself refuses to start in production, naming the variable only, when
# a required value is missing or still a placeholder
# (apps/backend/src/lib/production-env.ts).

# --- Runtime ---------------------------------------------------------------
# The image already sets NODE_ENV=production and TZ=UTC; do not set them here.
# shared: one process serves HTTP and runs jobs and subscribers.
WORKER_MODE=shared
MEDUSA_DISABLE_TELEMETRY=true

# --- Database: Supabase Postgres, Sydney (ap-southeast-2) ---------------------
# The DIRECT connection over IPv6 (Connect > Direct connection), port 5432. The droplet
# must be created with IPv6 enabled, and Docker's egress network has IPv6 on
# (infra/compose/docker-compose.prod.yml). The password is percent-encoded
# (letters and digits only needs no encoding). Direct is used instead of the session
# pooler because the pooler's connection limit (~15) is reached during a deploy
# (app + migrate).
#   postgresql://postgres:<password>@db.jiasljnsxhelgdakjgja.supabase.co:5432/postgres
# Fallback only if IPv6 is unavailable: the SESSION pooler (port 5432, never 6543):
#   postgresql://postgres.<project ref>:<password>@aws-<n>-ap-southeast-2.pooler.supabase.com:5432/postgres
# No ssl*, host, hostaddr, port, user, password or database query params: the TLS
# guard (src/lib/database-tls.ts) refuses them.
DATABASE_URL=
DB_SSL=true
DB_CA_PATH=/run/secrets/supabase-ca.crt
# special: the Supabase CA certificate file, base64 on one line. The workflow
# makes it from the GitHub secret SUPABASE_CA_CERT; apply-env.sh writes
# /opt/azira/certs/supabase-ca.crt, which compose mounts at DB_CA_PATH.
DB_CA_CERT_B64=

# --- Redis (the `redis` service in compose) -----------------------------------
# special: REDIS_PASSWORD goes only to the redis container (redis.env).
# REDIS_URL must be exactly redis://:<REDIS_PASSWORD>@redis:6379 (the workflow builds it).
REDIS_PASSWORD=
REDIS_URL=

# --- HTTP, CORS, secrets ------------------------------------------------------
# Each CORS entry must be an exact https:// origin, never localhost.
STORE_CORS=https://azira.com.au,https://www.azira.com.au
ADMIN_CORS=https://admin.azira.com.au
AUTH_CORS=https://admin.azira.com.au,https://azira.com.au,https://www.azira.com.au
# At least 32 characters, not "supersecret".
JWT_SECRET=
COOKIE_SECRET=
# Public URL of the admin dashboard (admin links in emails; the admin lives at <url>/app).
# Keep equal to the repository variable ADMIN_URL, which is baked into the admin bundle.
MEDUSA_BACKEND_URL=https://admin.azira.com.au

# --- Store ----------------------------------------------------------------------
STORE_NAME=Azira
# Optional: the seller's ABN for the tax invoice line.
STORE_ABN=
STORE_NOTIFY_EMAIL=
CUSTOM_ORDER_EMAIL=
# Storefront base URL including the country code, no trailing slash.
STOREFRONT_URL=https://azira.com.au/au

# --- Preview mode ("payments paused") ---------------------------------------------
# The deploy workflow sets this from the GitHub variable CHECKOUT_PAUSED (default
# true). While true: Stripe keys and RESEND_API_KEY may be absent (EMAIL_TRANSPORT
# console), and the backend refuses cart completion and payment sessions (403).
# Set the variable to false for real sales (docs/hosting.md, "Before launch").
CHECKOUT_PAUSED=true

# --- Payments: Stripe -----------------------------------------------------------
# Not needed while CHECKOUT_PAUSED=true.
# Live secret key (sk_live_...) and the signing secret (whsec_...) of the webhook
# endpoint https://api.azira.com.au/hooks/payment/stripe_stripe
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Files: Cloudflare R2 ---------------------------------------------------------
# Uploads go to the bucket azira-images through the S3 file provider; customers
# see them at FILE_URL (the bucket's public domain).
FILE_PROVIDER=s3
FILE_URL=https://img.azira.com.au
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://7b7865326875e0dea1285c31309d77a4.r2.cloudflarestorage.com
R2_BUCKET=azira-images

# --- Email: Resend -----------------------------------------------------------------
# resend for real sales; console (log only) is allowed while CHECKOUT_PAUSED=true.
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Azira <orders@azira.com.au>
# Optional: where customer replies go (a monitored inbox).
EMAIL_REPLY_TO=

# --- Not backend settings; consumed by apply-env.sh / compose ----------------------
# special: Cloudflare tunnel token (cloudflared container only, tunnel.env)
TUNNEL_TOKEN=
# special: image reference without a tag (the workflow computes it from the repository owner)
BACKEND_IMAGE=ghcr.io/<github-owner>/azira-backend
# special: the workflow's short-lived GITHUB_TOKEN, used once for `docker login ghcr.io`
GHCR_USER=
GHCR_TOKEN=
