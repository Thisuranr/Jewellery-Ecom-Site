# /opt/azira/backup.env: root:root, mode 0600. Read by azira-backup.service
# (EnvironmentFile=). No real values here; fill them in on the droplet only.
# Plain KEY=value lines: no "export" and no $VARS. Use letters and digits only
# in passwords and tokens, so no value needs quoting.

# ---- Database: Supabase, read over TLS verify-full -------------------------
# Supabase's DIRECT connection (IPv6; the droplet has IPv6): host
# db.jiasljnsxhelgdakjgja.supabase.co, port 5432, user postgres. (Fallback: the
# SESSION pooler, user postgres.<project ref>; never the transaction pooler 6543:
# pg_dump needs a session.)
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=verify-full
# The Supabase CA (Database settings, SSL configuration): the same file the
# backend uses, mode 0644.
BACKUP_PG_CA=/opt/azira/certs/supabase-ca.crt
# Optional: override the pinned pg_dump image (postgres:17.x@sha256:...), or
# the network its container joins (default host).
# BACKUP_PG_IMAGE=
# BACKUP_DOCKER_NETWORK=

# ---- Encryption -------------------------------------------------------------
# The public key printed by age-keygen (age1...). The private key never comes
# to this host (docs/hosting.md (Backups)).
BACKUP_AGE_RECIPIENT=

# ---- Upload: Cloudflare R2 bucket azira-db-backups ---------------------------
# A bucket-scoped API token for azira-db-backups only, permission
# "Object Read & Write". rclone reads the remote "r2" from these variables;
# there is no rclone.conf.
BACKUP_TARGET=r2
BACKUP_RCLONE_REMOTE=r2:azira-db-backups
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ENDPOINT=
RCLONE_CONFIG_R2_REGION=auto
RCLONE_CONFIG_R2_ACL=private
# A bucket-scoped token cannot create or check buckets.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# ---- Checks and alerting ----------------------------------------------------
# A backup smaller than this fails. After the first real backup, set it to
# about half of that backup's size.
BACKUP_MIN_BYTES=102400
# Optional heartbeat URL (a monitor that alerts when the ping stops): period 6 h, grace 30 min. The script appends
# /fail on errors.
BACKUP_HEARTBEAT_URL=
# One line per run.
BACKUP_LOG=/opt/azira/backup.log
