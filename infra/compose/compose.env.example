# /opt/azira/compose/.env (root, 0644; nothing secret here).
# Docker Compose reads it only to fill ${...} in docker-compose.prod.yml.
# You do not create it: apply-env.sh writes it on every deploy from the
# repository's owner name (the workflow computes it), for example:
BACKEND_IMAGE=ghcr.io/<github-owner-in-lowercase>/azira-backend
# The backend's own settings and secrets are in /opt/azira/.env instead
# (written by apply-env.sh; infra/env/backend.env.example lists every key).
